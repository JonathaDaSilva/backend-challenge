{
  "name": "backend-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate:up": "bun scripts/migrate.ts up",
    "db:migrate:down": "bun scripts/migrate.ts down",
    "db:migrate:create": "bun scripts/migrate.ts create",
    "db:migrate:pending": "bun scripts/migrate.ts pending"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.6",
    "@mikro-orm/migrations": "^7.2.6",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.6",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1"
  }
}
